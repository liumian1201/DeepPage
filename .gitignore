# ===== DeepPage .gitignore =====

# 私有文件（独立仓库 DeepPage-dev）
_private/

# 系统文件
.DS_Store
Thumbs.db
desktop.ini

# IDE / 编辑器
.vscode/
.idea/
*.swp
*.swo
*~

# Node.js 开发工具链（不随扩展发布，打包只取 src/）
node_modules/
# 注：package-lock.json 必须入库 —— CI 用 `npm ci` 复现依赖

# CI 下载的 Chromium（E2E 专用，体积大不入库）
.cache/

# 临时文件
*.tmp
*.log